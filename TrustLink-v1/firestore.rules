rules_version = '2';

// Deploy: Firebase Console → Firestore Database → Rules → paste this → Publish.
//
// Hardening requirements:
// 1. Field restrictions: request.resource.data.keys().hasOnly([...]) prevents injecting arbitrary fields.
// 2. Strict type checks on every allowed field.
// 3. API Key Restriction: In Google Cloud Console (APIs & Services → Credentials → Edit API Key),
//    restrict the API key to ONLY:
//      - Identity Toolkit API (for anonymous sign-in)
//      - Cloud Firestore API (for cross-device reliability sync)
//      - Firebase Remote Config API (for detection rule tuning)
//      - Firebase Installations API (for installation token management)
// 4. App Check: Enable Firebase App Check in Firebase Console → App Check for Firestore and Remote Config
//    to attest that requests originate only from the authentic TrustLink extension.

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isValidUserData() {
        let allowedKeys = ['manualScanCount', 'updatedAt', 'instagramRequirementCompleted', 'instagramVerifiedAt'];
        return request.resource.data.keys().hasOnly(allowedKeys)
          && request.resource.data.manualScanCount is int
          && request.resource.data.manualScanCount >= 0
          && request.resource.data.manualScanCount <= 100000
          && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is int || request.resource.data.updatedAt is timestamp)
          && (!('instagramRequirementCompleted' in request.resource.data) || request.resource.data.instagramRequirementCompleted is bool)
          && (!('instagramVerifiedAt' in request.resource.data) || request.resource.data.instagramVerifiedAt is int || request.resource.data.instagramVerifiedAt is timestamp);
      }

      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && isValidUserData();

      allow update: if request.auth != null
        && request.auth.uid == userId
        && isValidUserData()
        // Never allow the counter to move backwards from the client.
        && request.resource.data.manualScanCount >= resource.data.manualScanCount
        && request.resource.data.manualScanCount <= resource.data.manualScanCount + 1000;

      allow delete: if false; // reliability data is never client-deletable
    }
  }
}
